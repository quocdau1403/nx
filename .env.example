# PostgreSQL (Neon). Trên Vercel: Storage → Create → Neon, gắn vào project – 2 biến dưới được thêm tự động.
# Chạy trên máy: copy 2 giá trị từ Vercel → Settings → Environment Variables (hoặc `npx vercel env pull .env`).
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Kho ảnh Vercel Blob. Trên Vercel: Storage → Create → Blob, gắn vào project – biến được thêm tự động.
BLOB_READ_WRITE_TOKEN=""

# Chuỗi ngẫu nhiên ≥ 32 ký tự: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Tài khoản admin – tạo bằng: npm run db:seed
ADMIN_EMAIL="admin@ngocxinh.local"
ADMIN_PASSWORD=""
ADMIN_NAME="Ngọc Xinh"

# Chỉ dùng cho `npm run migrate:vercel` (thư mục ảnh của bản chạy SQLite cũ).
STORAGE_DIR="storage"

# Đồng bộ ảnh từ Facebook Page (Graph API). Mỗi fanpage cần một Page Access Token
# do quản trị viên fanpage tạo trong Meta for Developers. Để trống = tắt đồng bộ.
FB_GRAPH_VERSION="v21.0"
FB_TOKEN_ANH_CUOI=""
FB_TOKEN_MAKE_UP=""
FB_TOKEN_CONCEPT=""
